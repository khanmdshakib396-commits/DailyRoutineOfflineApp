<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙ Customize App"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Theme"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/lightTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☀ Light"
                android:textSize="17sp" />

            <RadioButton
                android:id="@+id/darkTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌙 Dark"
                android:textSize="17sp" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Size"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <SeekBar
            android:id="@+id/textSizeBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:progress="8" />

        <TextView
            android:id="@+id/textSizePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Text Preview"
            android:textSize="18sp"
            android:padding="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Button Style"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <RadioGroup
            android:id="@+id/buttonStyleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/buttonNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Normal Button" />

            <RadioButton
                android:id="@+id/buttonLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Large Button" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login Design"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <RadioGroup
            android:id="@+id/loginDesignGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/loginSimple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simple Login" />

            <RadioButton
                android:id="@+id/loginModern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modern Login" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Board Design"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <RadioGroup
            android:id="@+id/boardDesignGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/boardSimple"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simple Board" />

            <RadioButton
                android:id="@+id/boardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Card Board" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Background"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp" />

        <RadioGroup
            android:id="@+id/backgroundGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/backgroundWhite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="White" />

            <RadioButton
                android:id="@+id/backgroundGray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Light Gray" />

        </RadioGroup>

        <Button
            android:id="@+id/saveCustomize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE CUSTOMIZATION"
            android:textSize="17sp"
            android:layout_marginTop="25dp" />

        <Button
            android:id="@+id/resetCustomize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RESET TO DEFAULT"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/backDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← BACK TO DASHBOARD"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>
